{
  "name": "@procforge/local",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "procforge-local": "./dist/main.js",
    "procforge": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test -c playwright.config.ts",
    "pretest:e2e": "pnpm -w build",
    "lint": "tsc --noEmit -p tsconfig.json",
    "start": "node ./dist/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@procforge/core": "workspace:^",
    "@procforge/shared": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.4",
    "typescript": "^5.6.2",
    "vitest": "^2.1.3"
  }
}
